import("stdfaust.lib");

// HK ADNL Library
// Nonlinearities with Antiderivative Antialiasing.
//
// The waveform table layout is:
//   [coeffs flattened (num_segments * 9 floats), ymin, ymax, z_at_xmax]
//
// The runtime reads the three trailing metadata cells via rdtable at offsets
// t_size-3, t_size-2 and t_size-1.  See tools/gen_tables.py.
//
// The waveform `tbl` must be passed *directly* (a literal `waveform{...}` value
// or a top-level binding to one) so that Faust's rdtable lowering can populate
// the runtime read-only table with its contents.  Threading the table through
// extra layers of indirection (e.g. an integer "table id") does not work.

adnl_process(t_size, tbl, xmax, dx, x) = adaa_result
with {
    x_prev = x'; // previous-sample x via Faust 1-sample delay operator

    num_segments = int(2.0 * xmax / dx);
    raw_index = int((x + xmax) / dx);
    index = min(num_segments - 1, max(0, raw_index));
    w = x + xmax - float(index) * dx;

    base = index * 9;
    get(off) = rdtable(tbl, base + off);

    a3 = get(0);
    a2 = get(1);
    a1 = get(2);
    a0 = get(3);
    b4 = get(4);
    b3 = get(5);
    b2 = get(6);
    b1 = get(7);
    b0 = get(8);

    // Metadata at the table tail: [ymin, ymax, z_at_xmax].
    ymin      = rdtable(tbl, t_size - 3);
    ymax      = rdtable(tbl, t_size - 2);
    z_at_xmax = rdtable(tbl, t_size - 1);

    y1 = (((a3 * w + a2) * w + a1) * w + a0);
    z1 = ((((b4 * w + b3) * w + b2) * w + b1) * w + b0);

    // Out-of-range clamping.
    // NB: Faust select2(c, a, b) picks a when c=0, b when c=1 — opposite of C ?:.
    //   x <= -xmax  -> ymin
    //   x >=  xmax  -> ymax
    //   else        -> y1 (cubic) / z1 (quartic antiderivative)
    y1_final = select2(x > -xmax,
                       ymin,
                       select2(x < xmax, ymax, y1));

    z1_final = select2(x > -xmax,
                       ymin * (x + xmax),
                       select2(x < xmax,
                               z_at_xmax + ymax * (x - xmax),
                               z1));

    dx0 = x - x_prev;
    reldx0 = abs(dx0) / (abs(x + x_prev) + 1e-7);

    // Previous-sample y / z via 1-sample delay.
    z0 = z1_final';
    y0 = y1_final';

    safe_dx0 = select2(dx0 == 0, dx0, 1e-20);
    adaa_result = select2(reldx0 < 0.0001, (z1_final - z0) / safe_dx0, 0.5 * (y1_final + y0));
};
