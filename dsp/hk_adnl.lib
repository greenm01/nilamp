import("stdfaust.lib");

// HK ADNL Library
// Nonlinearities with Antiderivative Antialiasing

// ADNL Runtime
// table: the waveform block (size, id)
// xmax: range is [-xmax, xmax]
// dx: segment width
adnl_process(table, xmax, dx, x) = adaa_formula(x, x_prev)
with {
    // State: previous input
    x_prev = f_prev ~ _;
    f_prev(old_x) = x;

    // Lookup index and relative position w
    num_segments = int(2.0 * xmax / dx);
    raw_index = int((x + xmax) / dx);
    index = min(num_segments - 1, max(0, raw_index));
    w = x + xmax - float(index) * dx;

    // Boundary values
    ymin = -0.5; // Placeholder
    ymax = 1.0;  // Placeholder

    // Extract coefficients from table
    base = index * 9;
    
    a3 = table, (base + 0) : rdtable;
    a2 = table, (base + 1) : rdtable;
    a1 = table, (base + 2) : rdtable;
    a0 = table, (base + 3) : rdtable;
    b4 = table, (base + 4) : rdtable;
    b3 = table, (base + 5) : rdtable;
    b2 = table, (base + 6) : rdtable;
    b1 = table, (base + 7) : rdtable;
    b0 = table, (base + 8) : rdtable;

    // Compute f(x) and F(x)
    y1 = (((a3 * w + a2) * w + a1) * w + a0);
    z1 = ((((b4 * w + b3) * w + b2) * w + b1) * w + b0);

    // Handle out of bounds
    y1_final = select2(x > -xmax, ymin, select2(x < xmax, y1, ymax));
    z1_final = select2(x > -xmax, ymin * (x + xmax), 
                select2(x < xmax, z1, 
                    z_at_xmax + ymax * (x - xmax)));
    
    // Last segment's F(dx)
    last_base = (num_segments - 1) * 9;
    lb4 = table, (last_base + 4) : rdtable;
    lb3 = table, (last_base + 5) : rdtable;
    lb2 = table, (last_base + 6) : rdtable;
    lb1 = table, (last_base + 7) : rdtable;
    lb0 = table, (last_base + 8) : rdtable;
    z_at_xmax = ((((lb4 * dx + lb3) * dx + lb2) * dx + lb1) * dx + lb0);

    // ADNL formula
    dx0 = x - x_prev;
    reldx0 = abs(dx0) / (abs(x + x_prev) + 1e-7);

    // F(x) state
    z0 = f_z_prev ~ _;
    f_z_prev(old_z) = z1_final;
    y0 = f_y_prev ~ _;
    f_y_prev(old_y) = y1_final;

    // Safe division to avoid static analysis errors
    safe_dx0 = dx0 + (dx0 == 0) * 1e-20;
    adaa_formula(x_curr, x_p) = select2(reldx0 < 0.0001, (z1_final - z0) / safe_dx0, 0.5 * (y1_final + y0));
};
