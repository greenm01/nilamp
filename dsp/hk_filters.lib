// SPDX-License-Identifier: MIT
import("stdfaust.lib");

// HK Filter Library
// Ported from Helmut Keller's JSFX libraries

// --- 1st Order State Variable Filter (TPT) ---

// Better Faust-style SVF1
svf1(k, kdiv, x) = (hp, lp)
with {
    tick(s1) = next_s1, (hp, lp)
    with {
        hp = (x - s1) * kdiv;
        v = k * hp;
        lp = v + s1;
        next_s1 = v + lp;
    };
    res = tick ~ _;
    hp = res : ! , _ , ! : _;
    lp = res : ! , ! , _ : _;
};

// Keller's SVF1 setters
sv1_k(f, pwf) = select2(pwf, f * ma.PI / ma.SR, tan(f * ma.PI / ma.SR));
sv1_kdiv(k) = 1.0 / (1.0 + k);

// Low Shelf
flt_sv1_ls(kgain, fs, pwf, x) = hp * 1.0 + lp * kgain
with {
    k_raw = sv1_k(fs, pwf);
    k = k_raw / sqrt(kgain);
    kdiv = sv1_kdiv(k);
    hp = svf1(k, kdiv, x) : _ , !;
    lp = svf1(k, kdiv, x) : ! , _;
};

// High Shelf
flt_sv1_hs(kgain, fs, pwf, x) = hp * kgain + lp * 1.0
with {
    k_raw = sv1_k(fs, pwf);
    k = sqrt(kgain) * k_raw;
    kdiv = sv1_kdiv(k);
    hp = svf1(k, kdiv, x) : _ , !;
    lp = svf1(k, kdiv, x) : ! , _;
};

// --- 2nd Order State Variable Filter (TPT) ---

svf2(k, kf, kdiv, x) = (hp, bp, lp)
with {
    tick(s1, s2) = (next_s1, next_s2), (hp, bp, lp)
    with {
        hp = (x - kf*s1 - s2) * kdiv;
        v = k * hp;
        bp = v + s1;
        next_s1 = v + bp;
        v2 = k * bp;
        lp = v2 + s2;
        next_s2 = v2 + lp;
    };
    res = tick ~ (_,_);
    // res outputs: next_s1, next_s2, hp, bp, lp
    hp = res : ! , ! , _ , ! , ! : _;
    bp = res : ! , ! , ! , _ , ! : _;
    lp = res : ! , ! , ! , ! , _ : _;
};

// Keller's SVF2 setters
sv2_kq(f, Q, pwQ) = select2(pwQ, 1.0/Q, exp(aux2) - exp(-aux2))
with {
    k = f * ma.PI / ma.SR;
    aux1 = sqrt(1.0 + 4.0 * Q * Q);
    aux2 = (k / sin(2.0 * k + 1e-20)) * log((aux1 + 1.0) / (aux1 - 1.0));
};

sv2_k(f, pwf) = select2(pwf, f * ma.PI / ma.SR, tan(f * ma.PI / ma.SR));
sv2_kf(k, kq) = kq + k;
sv2_kdiv(k, kq) = 1.0 / (1.0 + k * (k + kq));

// Peak EQ
flt_sv2_peq(kgain, f, Qc, pwf, pwQ, x) = hp * 1.0 + bp * (kq_val * kgain) + lp * 1.0
with {
    kq_val = select2(pwQ, 1.0 / (sqrt(kgain) * Qc), sv2_kq(f, Qc * sqrt(kgain), pwQ));
    k = sv2_k(f, pwf);
    kf = sv2_kf(k, kq_val);
    kdiv = sv2_kdiv(k, kq_val);
    res = svf2(k, kf, kdiv, x);
    hp = res : _ , ! , !;
    bp = res : ! , _ , !;
    lp = res : ! , ! , _;
};

// Tonestack (2nd order)
flt_sv2_tst(b, m, t, f, Q, pwf, pwQ, x) = hp * t + bp * (kq_val * m) + lp * b
with {
    kq_val = sv2_kq(f, Q, pwQ);
    k = sv2_k(f, pwf);
    kf = sv2_kf(k, kq_val);
    kdiv = sv2_kdiv(k, kq_val);
    res = svf2(k, kf, kdiv, x);
    hp = res : _ , ! , !;
    bp = res : ! , _ , !;
    lp = res : ! , ! , _;
};

// --- Impulse Invariant 1st Order ---

flt_ii1_lp(f, x) = loop ~ _
with {
    k = 1.0 - exp(-2.0 * ma.PI * f / ma.SR);
    loop(s1) = (x - s1) * k + s1;
};

flt_ii1_hp(f, x) = x - flt_ii1_lp(f, x);

// --- Direct Form 2 ---

flt_df2(b0, b1, b2, a1, a2, x) = fi.tf2(b0, b1, b2, a1, a2, x);
