amp "keller_twd_dlx_ii" {
  metadata id="NILAMP_MODEL_KELLER_TWD_DLX_II" name="Keller TWD DLX II" family="5E3 tweed deluxe" brand="nilamp" clap_name="nilamp TWD MKII" clap_filename="nilamp-twd-mkii.clap" vst3_name="nilamp TWD MKII" vst3_filename="nilamp-twd-mkii.vst3" vst3_executable="nilamp-twd-mkii" vst3_bundle_id="dev.niltempus.nilamp.twd-mkii.vst3" about_title="TWD DLX II" version="Keller JSFX Version 1.0.4" author="by Helmut Keller" port="Ported to C by niltempus"

  dsp topology="tweed_5e3_cathodyne_pp" {
    speaker source_ohms=0.0 nominal_ohms=8.0

    stage "t1" symbol="KELLER_TWD_DLX_II_T1" kind="triode_ck" method="keller_glf_adaa" table="nilamp_t1_12ax7_table" len=13503 {
    coeffs kpre=0.372960373 isat=0.00165 rl=100000.0 rkl=0.0
    nonlinear kspre=0.004201680672 kspost=0.004201680672 ksva=0.3846153846 ksvk=0.0 ksib=0.000003193277311
    peak kfb=0.01515 kpk=0.0 xth=0.25 xdiode=0.25 attack=0.01 release=0.05 avg_tau=0.0375
  }

    stage "t2" symbol="KELLER_TWD_DLX_II_T2" kind="triode_ck" method="keller_glf_adaa" table="nilamp_t2_12ax7_table" len=13503 {
    coeffs kpre=0.3970223325 isat=0.00155 rl=100000.0 rkl=0.0
    nonlinear kspre=0.004201680672 kspost=0.004201680672 ksva=0.3846153846 ksvk=0.0 ksib=0.000003193277311
    peak kfb=0.01515 kpk=0.05 xth=0.255 xdiode=0.57 attack=0.015 release=0.05 avg_tau=0.0375
  }

    stage "t3" symbol="KELLER_TWD_DLX_II_T3" kind="cathodyne" method="keller_cd_adaa" table="nilamp_t3_cd_table" len=13503 {
    coeffs kpre=0.01054674317 isat=0.0016 rl=56000.0 rkl=57500.0
    nonlinear kspre=0.004201680672 kspost=0.004201680672 ksva=0.8282208589 ksvk=0.1763803681 ksib=0.000003067226891
    peak kfb=0.0 kpk=0.125 xth=0.272 xdiode=0.394 attack=0.00085 release=0.3872 avg_tau=0.0
  }

    stage "t4" symbol="KELLER_TWD_DLX_II_T4" kind="power_ck" method="keller_glf_adaa" table="nilamp_t4_6v6_table" len=13503 {
    coeffs kpre=0.02642706131 isat=0.11 rl=3000.0 rkl=0.0
    nonlinear kspre=0.0 kspost=0.00289017341 ksva=0.9302325581 ksvk=0.0 ksib=0.0001213872832
    peak kfb=0.18144 kpk=0.125 xth=0.309 xdiode=0.437 attack=0.00575 release=0.0276 avg_tau=0.00675
  }

    stage "t5" symbol="KELLER_TWD_DLX_II_T5" kind="power_ck" method="keller_glf_adaa" table="nilamp_t5_6v6_table" len=13503 {
    coeffs kpre=0.0242248062 isat=0.12 rl=3000.0 rkl=0.0
    nonlinear kspre=0.0 kspost=0.00289017341 ksva=0.9302325581 ksvk=0.0 ksib=0.0001213872832
    peak kfb=0.18144 kpk=0.18 xth=0.325 xdiode=0.388 attack=0.00155 release=0.0234 avg_tau=0.00675
  }

    supply method="keller_pss" {
    node "p1" r=125.0 tau=0.008
    node "p2" r=5100.0 tau=0.0816
    node "p3" r_at_full_sag=22000.0 tau=0.352
  }

    process input_feed_gain=1.0 input_gain_offset_db=12.0 input_keller_gain_sq=1.2 gain_comp_12ax7=0.572 gain_comp_ltp_base=0.0345 phase_t4_gain=0.797 phase_t5_gain=0.940 screen_current_feedback=0.025

    controls {
    control "input_gain" id="NILAMP_PARAM_GAIN_DB" name="Gain" host_name="Input Gain" module="Input" unit="dB" min=-12.0 max=12.0 default=0.0 step=0.5 display="linear"
    control "volume" id="NILAMP_PARAM_VOLUME_PCT" name="Volume" module="Pre Amp" unit="%" min=0.0 max=100.0 default=50.0 step=2.5 display="linear"
    control "bass" id="NILAMP_PARAM_BASS_PCT" name="Bass" module="Pre Amp" unit="%" min=0.0 max=100.0 default=50.0 step=2.5 display="linear"
    control "mid" id="NILAMP_PARAM_MID_PCT" name="Mid" module="Pre Amp" unit="%" min=0.0 max=100.0 default=50.0 step=2.5 display="linear"
    control "treble" id="NILAMP_PARAM_TREBLE_PCT" name="Treble" module="Pre Amp" unit="%" min=0.0 max=100.0 default=50.0 step=2.5 display="linear"
    control "sag" id="NILAMP_PARAM_SAG_PCT" name="Sag" module="Power" unit="%" min=0.0 max=100.0 default=50.0 step=2.5 display="linear"
    control "output_gain" id="NILAMP_PARAM_OUTPUT_GAIN_DB" name="Gain" host_name="Output Gain" module="Output" unit="dB" min=-12.0 max=12.0 default=0.0 step=0.5 display="linear"
    control "tone_fmid" id="NILAMP_PARAM_TONE_FMID_DBHZ" name="Fmid" module="Tone Stack" unit="Hz" min=44.0 max=68.0 default=56.0 step=0.5 display="iso266"
    control "tone_qmid" id="NILAMP_PARAM_TONE_QMID_DB" name="Qmid" module="Tone Stack" unit="" min=-18.0 max=6.0 default=-6.0 step=0.5 display="iso266"
    control "speaker_res_gain1" id="NILAMP_PARAM_SPK_RES_GAIN1_DB" name="Gain 1" host_name="Speaker Resonance Gain 1" module="Speaker Resonance" unit="dB" min=0.0 max=24.0 default=1.0 step=0.5 display="linear"
    control "speaker_res_gain2" id="NILAMP_PARAM_SPK_RES_GAIN2_DB" name="Gain 2" host_name="Speaker Resonance Gain 2" module="Speaker Resonance" unit="dB" min=0.0 max=24.0 default=2.0 step=0.5 display="linear"
    control "speaker_res_fres" id="NILAMP_PARAM_SPK_RES_FRES_DBHZ" name="Fres" module="Speaker Resonance" unit="Hz" min=26.0 max=50.0 default=38.0 step=0.5 display="iso266"
    control "speaker_res_qts" id="NILAMP_PARAM_SPK_RES_QTS_DB" name="Qts" module="Speaker Resonance" unit="" min=-6.0 max=18.0 default=6.0 step=0.5 display="iso266"
    control "speaker_ind_gain1" id="NILAMP_PARAM_SPK_IND_GAIN1_DB" name="Gain 1" host_name="Speaker Inductor Gain 1" module="Speaker Inductor" unit="dB" min=0.0 max=24.0 default=3.0 step=0.5 display="linear"
    control "speaker_ind_gain2" id="NILAMP_PARAM_SPK_IND_GAIN2_DB" name="Gain 2" host_name="Speaker Inductor Gain 2" module="Speaker Inductor" unit="dB" min=0.0 max=24.0 default=3.0 step=0.5 display="linear"
    control "speaker_ind_find" id="NILAMP_PARAM_SPK_IND_FIND_DBHZ" name="Find" module="Speaker Inductor" unit="Hz" min=50.0 max=74.0 default=62.0 step=0.5 display="iso266"
    control "gain_comp" id="NILAMP_PARAM_GAIN_COMP" name="Compens." module="Gain" unit="" min=0.0 max=3.0 default=2.0 step=1.0 display="enum" {
      option "Off"
      option "Tube 1"
      option "Splitter"
      option "Both"
    }
    control "tube1" id="NILAMP_PARAM_TUBE1" name="Tube 1" module="Pre Amp" unit="" min=0.0 max=1.0 default=1.0 step=1.0 display="enum" {
      option "12AY7"
      option "12AX7"
    }
    control "phase_splitter" id="NILAMP_PARAM_PHASE_SPLITTER" name="Circuit" module="Splitter" unit="" min=0.0 max=4.0 default=2.0 step=1.0 display="enum" {
      option "CD 5E3"
      option "CD BAL"
      option "LTP 1"
      option "LTP 2"
      option "LTP 3"
    }
    control "bypass" id="NILAMP_PARAM_BYPASS" name="Bypass" module="Global" unit="" min=0.0 max=1.0 default=0.0 step=1.0 display="enum" {
      option "Off"
      option "On"
    }
    }
  }

  gui width=500 height=340 default_screen="main" {
    theme background="#1c2d3d" header="#182532" header_rule="#536777" panel="#223444" border="#697b89" text="#ffcd20"

    screen "main" id="NILAMP_GUI_SCREEN_ID_MAIN" title="TWD DLX II" {
      text "$about_title" x=0 y=10 w=500 h=18 style="normal"
      button "Options" x=433 y=2 w=65 h=28 target="options"
      panel "Input" x=10 y=43 w=93 h=139
      panel "Output" x=400 y=43 w=93 h=139
      panel "Pre Amp" x=10 y=189 w=386 h=138
      panel "Splitter" x=400 y=189 w=93 h=138
      text "$brand" x=0 y=73 w=500 h=50 style="title"
      text "$name" x=0 y=122 w=500 h=28 style="subtitle"
      knob bind="input_gain" x=17 y=55 w=80 h=104 radius=23 style="gain_bipolar"
      knob bind="output_gain" x=406 y=55 w=80 h=104 radius=23 style="gain_bipolar"
      toggle bind="tube1" x=21 y=207 w=76 h=104
      knob bind="volume" x=93 y=202 w=80 h=104 radius=23 style="percent"
      knob bind="bass" x=169 y=202 w=80 h=104 radius=23 style="percent"
      knob bind="mid" x=245 y=202 w=80 h=104 radius=23 style="percent"
      knob bind="treble" x=321 y=202 w=80 h=104 radius=23 style="percent"
      enum bind="phase_splitter" x=407 y=207 w=79 h=104
    }

    screen "options" id="NILAMP_GUI_SCREEN_ID_OPTIONS" title="Options" {
      text "Options" x=0 y=10 w=500 h=18 style="normal"
      button "< back" x=0 y=2 w=65 h=28 target="main"
      button "About" x=435 y=2 w=63 h=28 target="about"
      panel "Tone Stack" x=10 y=43 w=165 h=139
      panel "Speaker Inductor" x=256 y=43 w=237 h=139
      panel "Power" x=10 y=189 w=78 h=138
      panel "Gain" x=97 y=189 w=94 h=138
      panel "Speaker Resonance" x=200 y=189 w=293 h=138
      knob bind="tone_fmid" x=18 y=55 w=80 h=104 radius=23 style="percent"
      knob bind="tone_qmid" x=93 y=55 w=80 h=104 radius=23 style="percent"
      knob bind="speaker_ind_gain1" x=273 y=55 w=80 h=104 radius=23 style="percent"
      knob bind="speaker_ind_gain2" x=345 y=55 w=80 h=104 radius=23 style="percent"
      knob bind="speaker_ind_find" x=417 y=55 w=80 h=104 radius=23 style="percent"
      knob bind="sag" x=9 y=202 w=80 h=104 radius=23 style="percent"
      enum bind="gain_comp" x=101 y=207 w=86 h=104
      knob bind="speaker_res_gain1" x=203 y=202 w=80 h=104 radius=23 style="percent"
      knob bind="speaker_res_gain2" x=275 y=202 w=80 h=104 radius=23 style="percent"
      knob bind="speaker_res_fres" x=347 y=202 w=80 h=104 radius=23 style="percent"
      knob bind="speaker_res_qts" x=419 y=202 w=80 h=104 radius=23 style="percent"
    }

    screen "about" id="NILAMP_GUI_SCREEN_ID_ABOUT" title="About" {
      text "About" x=0 y=10 w=500 h=18 style="normal"
      button "< back" x=0 y=2 w=65 h=28 target="options"
      text "$about_title" x=0 y=72 w=500 h=25 style="about"
      text "$version" x=0 y=104 w=500 h=25 style="about"
      text "$author" x=0 y=136 w=500 h=25 style="about"
      text "$port" x=0 y=168 w=500 h=25 style="about"
    }
  }
}
